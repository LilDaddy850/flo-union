---
// Scroll-driven 3D intro (home page only). Three full-page swipes: the storm, the gutter, the dive.
// The poster is the LCP; the 3D bundle loads after the page is idle and only when the device can take it.
import { getImage } from 'astro:assets';
import lockup from '../assets/brand/lockup.png';
import posterL from '../assets/intro-poster-l.jpg';
import posterP from '../assets/intro-poster-p.jpg';
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const pl = await getImage({ src: posterL, width: 1600, format: 'webp', quality: 70 });
const pp = await getImage({ src: posterP, width: 900, format: 'webp', quality: 70 });
const lock = await getImage({ src: lockup, width: 800, format: 'webp' });
---
<section class="intro" id="intro" aria-label={t(lang, 'intro.label')}>
  <div class="intro-stage">
    <picture class="intro-poster">
      <source media="(orientation: portrait)" srcset={pp.src} />
      <img src={pl.src} width={pl.attributes.width} height={pl.attributes.height} alt="" fetchpriority="high" decoding="async" />
    </picture>
    <canvas class="intro-canvas" aria-hidden="true"></canvas>
    <div class="intro-grain" aria-hidden="true"></div>
    <div class="intro-cap intro-cap1">
      <p class="intro-eyebrow">{t(lang, 'intro.cap1Eyebrow')}</p>
      <p class="intro-title">{t(lang, 'intro.cap1Title')}</p>
      <p class="intro-body">{t(lang, 'intro.cap1Body')}</p>
    </div>
    <div class="intro-cap intro-cap2">
      <img class="intro-lockup" src={lock.src} width={lock.attributes.width} height={lock.attributes.height} alt="Flo Union LLC" loading="lazy" decoding="async" />
      <p class="intro-eyebrow">{t(lang, 'intro.cap2Eyebrow')}</p>
      <p class="intro-body">{t(lang, 'intro.cap2Body')}</p>
    </div>
    <div class="intro-fade" aria-hidden="true"></div>
    <p class="intro-hint" aria-hidden="true"><span class="intro-hint-line"></span>{t(lang, 'intro.scroll')}</p>
    <button class="intro-skip" type="button">{t(lang, 'intro.skip')}</button>
  </div>
</section>

<style>
  .intro { height: 300svh; position: relative; background: #0a0d16; color: var(--text-light); }
  .intro.intro-off { display: none; }
  .intro-stage { position: sticky; top: 0; height: 100svh; overflow: hidden; background: #0a0d16; }
  .intro-poster, .intro-canvas, .intro-grain, .intro-fade { position: absolute; inset: 0; }
  .intro-poster { transition: opacity 0.7s var(--ease); z-index: 1; }
  .intro-poster img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .intro.is-live .intro-poster { opacity: 0; }
  .intro-canvas { display: block; width: 100%; height: 100%; }
  .intro-stage::after { content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 2; background: radial-gradient(ellipse at 50% 45%, transparent 50%, rgba(5, 8, 18, 0.55) 100%); }
  .intro-grain { pointer-events: none; opacity: 0.09; mix-blend-mode: overlay; z-index: 2; background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"); }
  .intro-fade { background: #0a0d16; opacity: 0; pointer-events: none; z-index: 5; }
  .intro-cap { position: absolute; z-index: 3; opacity: 0; pointer-events: none; max-width: min(90vw, 460px); }
  .intro-eyebrow { font-family: var(--f-label); font-size: var(--t-label); letter-spacing: 0.22em; text-transform: uppercase; color: var(--orange); margin: 0 0 14px; }
  .intro-title { font-family: var(--f-head); font-weight: 800; font-size: clamp(2.6rem, 6vw, 5.6rem); line-height: 0.95; letter-spacing: -0.01em; margin: 0; color: var(--text-light); text-wrap: balance; }
  .intro-body { font-size: clamp(1.05rem, 1.6vw, 1.35rem); color: #d8d4cc; margin: 16px 0 0; line-height: 1.45; }
  .intro-cap1 { left: 6%; bottom: 12%; }
  .intro-cap2 { right: 6%; bottom: 12%; text-align: right; }
  .intro-lockup { width: min(56vw, 400px); max-width: 100%; height: auto; margin: 0 0 18px; display: inline-block; }
  .intro-hint { position: absolute; left: 50%; bottom: 26px; transform: translateX(-50%); z-index: 3; display: flex; flex-direction: column; align-items: center; gap: 10px; margin: 0; font-family: var(--f-label); font-size: 0.625rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--dim-on-dark); pointer-events: none; }
  .intro-hint-line { display: block; width: 1px; height: 34px; background: linear-gradient(180deg, transparent, var(--orange)); animation: intro-drop 1.6s var(--ease) infinite; }
  @keyframes intro-drop { 0% { transform: scaleY(0); transform-origin: top; opacity: 0; } 30% { opacity: 1; } 100% { transform: scaleY(1); transform-origin: top; opacity: 0; } }
  .intro-skip { position: absolute; right: 20px; top: 94px; z-index: 6; min-height: 40px; padding: 0 16px; border: 1px solid rgba(244, 241, 236, 0.35); border-radius: var(--radius); background: rgba(10, 13, 22, 0.45); color: var(--text-light); font-family: var(--f-label); font-size: 0.625rem; letter-spacing: 0.18em; text-transform: uppercase; cursor: pointer; opacity: 0; animation: intro-skip-in 0.6s var(--ease) 1.6s forwards; backdrop-filter: blur(6px); }
  .intro-skip:hover { border-color: var(--orange); }
  @keyframes intro-skip-in { to { opacity: 1; } }
  @media (max-width: 899px) { .intro-skip { top: 16px; } }
  @media (max-width: 599px) {
    .intro-cap1, .intro-cap2 { left: 0; right: 0; bottom: 0; padding: 40% 6% 22%; text-align: left; max-width: none; background: linear-gradient(180deg, rgba(10, 13, 22, 0) 0%, rgba(10, 13, 22, 0.82) 55%, rgba(10, 13, 22, 0.92) 100%); }
    .intro-lockup { width: 62vw; }
    .intro-hint { bottom: 76px; }
  }
  @media (prefers-reduced-motion: reduce) { .intro { display: none; } }
</style>

<script>
  const section = document.getElementById('intro') as HTMLElement | null;
  if (section) {
    const canvas = section.querySelector('canvas') as HTMLCanvasElement;
    const nav = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number };
    const hasGl = (() => { try { return !!document.createElement('canvas').getContext('webgl2'); } catch { return false; } })();
    const skipped = (() => { try { return sessionStorage.getItem('flo-intro') === 'skip'; } catch { return false; } })();
    const ok = hasGl && matchMedia('(prefers-reduced-motion: no-preference)').matches && !nav.connection?.saveData && (nav.deviceMemory ?? 8) >= 3 && !skipped && !location.hash;
    if (!ok) {
      section.classList.add('intro-off');
    } else {
      const q = (s: string) => section.querySelector(s) as HTMLElement | null;
      const skip = q('.intro-skip');
      const boot = async () => {
        const { startIntro } = await import('../intro/index');
        startIntro(section, canvas, { cap1: q('.intro-cap1'), cap2: q('.intro-cap2'), fade: q('.intro-fade'), hint: q('.intro-hint'), onReady: () => section.classList.add('is-live') });
      };
      skip?.addEventListener('click', () => {
        try { sessionStorage.setItem('flo-intro', 'skip'); } catch {}
        window.scrollTo({ top: section.offsetTop + section.offsetHeight, behavior: 'smooth' });
      });
      const idle = (fn: () => void) => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(fn, { timeout: 3000 }) : setTimeout(fn, 600));
      const later = () => setTimeout(() => idle(boot), 700);
      if (document.readyState === 'complete') later(); else addEventListener('load', later, { once: true });
    }
  }
</script>
