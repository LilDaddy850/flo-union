---
import Photo from './Photo.astro';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang; stems: string[]; title?: string; eyebrow?: string; theme?: 'dark' | 'light'; }
const { lang, stems, title, eyebrow, theme = 'dark' } = Astro.props;
---
<section class:list={['section', `theme-${theme}`]}>
  <div class="wrap">
    {(title || eyebrow) && (
      <div class="section-head reveal">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {title && <h2 class="h-1">{title}</h2>}
      </div>
    )}
    <div class="grid">
      {stems.map((s, i) => (
        <figure class:list={['cell reveal', i % 3 === 1 && 'reveal-d1', i % 3 === 2 && 'reveal-d2']}>
          <Photo stem={s} lang={lang} widths={[480, 800, 1200]} sizes="(max-width: 899px) 100vw, 33vw" />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s3); }
  .cell { border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4 / 3; background: var(--surface); }
  .cell :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .cell:hover :global(img) { transform: scale(1.04); }
  .cell:nth-child(6n + 1), .cell:nth-child(6n + 4), .cell:nth-child(6n + 5) { grid-column: span 2; aspect-ratio: 3 / 2; }
  @media (max-width: 899px) {
    .grid { grid-template-columns: 1fr 1fr; gap: var(--s2); }
    .cell:nth-child(n) { grid-column: auto; aspect-ratio: 4 / 3; }
    .cell:nth-child(6n + 1), .cell:nth-child(6n) { grid-column: span 2; aspect-ratio: 3 / 2; }
  }
</style>
