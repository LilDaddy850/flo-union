---
import { Image } from 'astro:assets';
import { photo } from '../lib/photos';
import { alt as alts } from '../data/projects';
import type { Lang } from '../i18n/routes';

interface Props {
  stem: string;
  lang: Lang;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}
const { stem, lang, widths = [480, 800, 1200, 1600], sizes = '(max-width: 899px) 100vw, 50vw', loading = 'lazy', class: cls } = Astro.props;
const src = photo(stem);
const altText = alts[stem]?.[lang];
if (!altText) throw new Error(`Missing ${lang} alt text for photo "${stem}"`);
---
<Image src={src} alt={altText} widths={widths} sizes={sizes} loading={loading} decoding="async" class={cls} format="webp" quality={76} />
