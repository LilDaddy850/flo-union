---
import type { Faq } from '../data/faq';
import { href, pageUrl, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
interface Props { lang: Lang; items: Faq[]; title?: string; eyebrow?: string; theme?: 'dark' | 'light'; linkAll?: boolean; }
const { lang, items, title = t(lang, 'faq.title'), eyebrow = t(lang, 'faq.eyebrow'), theme = 'dark', linkAll = false } = Astro.props;
---
<section class:list={['section', `theme-${theme}`]} id="faq">
  <div class="wrap faq-grid">
    <div class="section-head reveal">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="h-1">{title}</h2>
      {linkAll && <p><a class="all" href={href(pageUrl('faq', lang))}>{t(lang, 'faq.all')} →</a></p>}
    </div>
    <div class="list reveal reveal-d1">
      {items.map((f) => (
        <details>
          <summary><span>{f.q[lang]}</span><span class="plus" aria-hidden="true"></span></summary>
          <p class="dim">{f.a[lang]}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-grid { display: grid; grid-template-columns: 1fr 1.6fr; gap: var(--s5); align-items: start; }
  .all { font-family: var(--f-label); font-size: var(--t-label); letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent-text); display: inline-block; margin-top: var(--s3); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: var(--s3); padding: 22px 0; font-family: var(--f-head); font-weight: 600; font-size: clamp(1.15rem, 1.6vw, 1.4rem); line-height: 1.2; }
  .plus { position: relative; width: 18px; height: 18px; flex-shrink: 0; }
  .plus::before, .plus::after { content: ''; position: absolute; background: var(--orange); left: 50%; top: 50%; transform: translate(-50%, -50%); transition: transform 0.3s var(--ease); }
  .plus::before { width: 18px; height: 2px; }
  .plus::after { width: 2px; height: 18px; }
  details[open] .plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  details p { padding: 0 0 24px; max-width: 58ch; }
  @media (max-width: 899px) { .faq-grid { grid-template-columns: 1fr; gap: var(--s3); } }
</style>
