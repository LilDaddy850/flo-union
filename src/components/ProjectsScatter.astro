---
import Photo from './Photo.astro';
import type { Project } from '../data/projects';
import { href, pageUrl, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props { lang: Lang; items: Project[]; link?: boolean; showAll?: boolean; as?: 'h1' | 'h2'; }
const { lang, items, link = true, showAll = false, as = 'h2' } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const Heading = as;
---
<section class="section theme-dark projects" id="projects">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{t(lang, 'projects.eyebrow')}</p>
      <Heading class:list={[as === 'h1' ? 'h-hero' : 'h-1']}>{t(lang, 'projects.title')}</Heading>
    </div>

    <div class="scatter">
      {items.map((p, i) => {
        const Tag = link ? 'a' : 'div';
        return (
          <article class:list={['pj', `pj-${(i % 6) + 1}`, 'reveal']} id={p.slug}>
            <Tag href={link ? href(pageUrl('projects', lang)) + '#' + p.slug : undefined} class="pj-link">
              <div class="pj-media">
                <Photo stem={p.cover} lang={lang} widths={[480, 800, 1200]} sizes="(max-width: 899px) 100vw, 58vw" />
              </div>
              <div class="pj-cap">
                <span class="pj-n">{pad(p.n)}</span>
                <h3 class="h-3">{p.title[lang]}</h3>
                <p class="small dim">{p.where[lang]} · {p.year}</p>
              </div>
            </Tag>
          </article>
        );
      })}
    </div>

    {showAll && (
      <div class="all reveal">
        <a class="btn ghost" href={href(pageUrl('projects', lang))}>{t(lang, 'projects.all')}</a>
      </div>
    )}
  </div>
</section>

<style>
  .scatter { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--s4) var(--s3); align-items: start; }
  .pj { position: relative; }
  .pj-link { display: block; }
  .pj-media { border-radius: var(--radius-lg); overflow: hidden; background: var(--graphite); }
  .pj-media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .pj-link:hover .pj-media :global(img) { transform: scale(1.04); }
  .pj-cap { position: relative; margin-top: -28px; margin-left: var(--s3); background: var(--charcoal); display: inline-block; padding: 14px 18px 4px 0; max-width: calc(100% - var(--s3)); }
  .pj-n { display: block; font-family: var(--f-label); font-size: var(--t-label); letter-spacing: 0.2em; color: var(--orange); margin-bottom: 8px; }
  .pj-cap p { margin-top: 4px; }

  /* the scatter: six slot patterns cycling */
  .pj-1 { grid-column: 1 / 8; }
  .pj-1 .pj-media { aspect-ratio: 3 / 2; }
  .pj-2 { grid-column: 8 / 13; margin-top: clamp(32px, 6vw, 96px); }
  .pj-2 .pj-media { aspect-ratio: 4 / 5; }
  .pj-3 { grid-column: 2 / 7; }
  .pj-3 .pj-media { aspect-ratio: 4 / 5; }
  .pj-4 { grid-column: 7 / 13; margin-top: clamp(40px, 7vw, 120px); }
  .pj-4 .pj-media { aspect-ratio: 3 / 2; }
  .pj-5 { grid-column: 1 / 7; }
  .pj-5 .pj-media { aspect-ratio: 5 / 4; }
  .pj-6 { grid-column: 7 / 12; margin-top: clamp(24px, 5vw, 80px); }
  .pj-6 .pj-media { aspect-ratio: 4 / 5; }

  .all { margin-top: var(--s5); }

  @media (max-width: 899px) {
    .scatter { grid-template-columns: 1fr; gap: var(--s4); }
    .pj { grid-column: 1 / -1 !important; margin-top: 0 !important; }
    .pj:nth-child(even) { margin-left: 8%; }
    .pj:nth-child(odd) { margin-right: 8%; }
    .pj .pj-media { aspect-ratio: 4 / 3; }
    .pj-cap { margin-top: -22px; margin-left: 14px; }
  }
</style>
