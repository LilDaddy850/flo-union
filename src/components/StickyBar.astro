---
import { site } from '../data/site';
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<div class="sticky-bar" role="group" aria-label="Contact">
  <a class="sb call" href={`tel:${site.phoneE164}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1L6.6 10.8z"/></svg>
    {t(lang, 'cta.tapCall')}
  </a>
  <a class="sb text" href={`sms:${site.phoneE164}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9l-5 4v-4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/></svg>
    {t(lang, 'cta.tapText')}
  </a>
</div>

<style is:global>
  .sticky-bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 200;
    display: none; grid-template-columns: 1fr 1fr; gap: 1px;
    background: rgba(28, 28, 30, 0.9);
    border-top: 1px solid rgba(244, 241, 236, 0.1);
    padding-bottom: env(safe-area-inset-bottom);
    backdrop-filter: blur(10px);
  }
  .sticky-bar .sb {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    min-height: 60px;
    font-family: var(--f-label); font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: #FFF7F0;
  }
  .sticky-bar .sb svg { width: 18px; height: 18px; fill: currentColor; }
  .sticky-bar .call { background: var(--grad-orange); }
  .sticky-bar .text { background: var(--graphite); }
  @media (max-width: 899px) {
    .sticky-bar { display: grid; }
    body { padding-bottom: calc(60px + env(safe-area-inset-bottom)); }
  }
</style>
