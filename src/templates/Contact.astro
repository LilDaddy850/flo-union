---
import Base from '../layouts/Base.astro';
import AreaMap from '../components/AreaMap.astro';
import { site } from '../data/site';
import { other, pageUrl, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const meta = {
  en: { title: 'Contact Flo Union LLC | Call or Text 689-267-7320', description: 'Call or text 689-267-7320 for a free same-day seamless gutter estimate in Central Florida, Tampa, and Sarasota. Open 7 days a week. Hablamos español.' },
  es: { title: 'Contacto Flo Union LLC | Llame o mande un texto al 689-267-7320', description: 'Llame o mande un texto al 689-267-7320 para un estimado gratis de canaletas sin costura el mismo día en Florida Central, Tampa y Sarasota. Abierto los 7 días.' },
}[lang];
---
<Base lang={lang} title={meta.title} description={meta.description} path={pageUrl('contact', lang)} altPath={pageUrl('contact', other(lang))}>
  <section class="section theme-dark contact">
    <div class="wrap">
      <p class="eyebrow">{t(lang, 'contact.eyebrow')}</p>
      <h1 class="h-hero">{t(lang, 'contact.title')}</h1>
      <p class="lead">{t(lang, 'contact.sub')}</p>

      <div class="cards">
        <a class="card reveal" href={`tel:${site.phoneE164}`}>
          <span class="eyebrow">{t(lang, 'contact.phone')}</span>
          <span class="big">{site.phone}</span>
          <span class="act">{t(lang, 'cta.call')} →</span>
        </a>
        <a class="card reveal reveal-d1" href={`sms:${site.phoneE164}`}>
          <span class="eyebrow">SMS</span>
          <span class="big">{site.phone}</span>
          <span class="act">{t(lang, 'cta.text')} →</span>
        </a>
        <a class="card reveal reveal-d2" href={`mailto:${site.email}`}>
          <span class="eyebrow">{t(lang, 'contact.email')}</span>
          <span class="big email">{site.email}</span>
          <span class="act">{t(lang, 'cta.email')} →</span>
        </a>
      </div>

      <dl class="facts reveal">
        <div><dt class="eyebrow">{t(lang, 'contact.hours')}</dt><dd>{t(lang, 'footer.hours')}</dd></div>
        <div><dt class="eyebrow">{t(lang, 'contact.area')}</dt><dd>{site.area[lang]}</dd></div>
        <div><dt class="eyebrow">{t(lang, 'stats.licensed')}</dt><dd>{t(lang, 'stats.licensedSub')}{site.license && ` · ${t(lang, 'footer.license')} ${site.license}`}</dd></div>
      </dl>
    </div>
  </section>
  <AreaMap lang={lang} />
</Base>

<style>
  .contact { padding-block: var(--s5) var(--s6); }
  .contact .eyebrow { margin-bottom: var(--s3); }
  .contact .lead { margin-top: var(--s3); }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s3); margin-top: var(--s5); }
  .card { display: flex; flex-direction: column; gap: 14px; padding: var(--s4); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--graphite); transition: border-color 0.3s var(--ease), transform 0.3s var(--ease); }
  .card:hover { border-color: var(--orange); transform: translateY(-3px); }
  .card .eyebrow { margin: 0; }
  .big { font-family: var(--f-head); font-weight: 800; font-size: clamp(1.6rem, 2.6vw, 2.4rem); letter-spacing: -0.01em; line-height: 1; }
  .email { font-size: clamp(1.1rem, 1.6vw, 1.5rem); word-break: break-all; }
  .act { margin-top: auto; font-family: var(--f-label); font-size: var(--t-label); letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent-text); }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s3); margin-top: var(--s5); border-top: 1px solid var(--line); padding-top: var(--s4); }
  .facts dt { margin-bottom: 8px; color: var(--dim-on-dark); }
  .facts dd { font-family: var(--f-head); font-weight: 600; font-size: 1.25rem; }
  @media (max-width: 899px) { .cards, .facts { grid-template-columns: 1fr; } }
</style>
